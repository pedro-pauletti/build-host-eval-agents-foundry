# ---------------------------------------------------------------------------
# Zava Foundry Demos - environment template
# Copy to .env and fill in. Most values are emitted by `azd env get-values`
# after provisioning (see infra/ and scripts/).
# ---------------------------------------------------------------------------

# --- Azure / subscription ---
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_LOCATION=eastus2
AZURE_RESOURCE_GROUP=rg-zava-demo
AZURE_ENV_NAME=zava-demo

# --- Foundry project ---
AZURE_AI_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>

# --- Model deployments ---
# gpt-4.1 is PINNED for the InventoryAgent, the Foundry IQ knowledge base and the eval judge.
# Reason: (1) a Foundry prompt agent on `model-router` fails MCP tool calls with
# `tool_function_not_found` (500); (2) AI Search knowledge bases reject `model-router`
# (allow-list: gpt-4o / gpt-4.1 / gpt-5.x only); (3) a judge model should be deterministic.
# Everything with no tools uses MODEL_ROUTER_DEPLOYMENT_NAME instead.
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4.1
MODEL_ROUTER_DEPLOYMENT_NAME=model-router
EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large
REALTIME_DEPLOYMENT_NAME=gpt-realtime-mini

# --- Azure AI Search (Foundry IQ knowledge base) ---
AZURE_SEARCH_ENDPOINT=https://<search>.search.windows.net
AZURE_SEARCH_INDEX_NAME=zava-docs
AZURE_SEARCH_CONNECTION_ID=

# --- Zava backends (Azure Container Apps) ---
ZAVA_API_BASE_URL=http://localhost:8000
ZAVA_MCP_URL=http://localhost:8080/mcp

# --- Foundry Toolbox (do NOT use FOUNDRY_ prefix for this one) ---
TOOLBOX_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>/toolboxes/zava-tools/mcp?api-version=v1

# --- Fabric (Zava-Demos workspace) ---
FABRIC_WORKSPACE_ID=<your-fabric-workspace-id>
FABRIC_WORKSPACE_NAME=Zava-Demos
FABRIC_DATA_AGENT_NAME=ZavaDataAgent
# Set by data/semantic-model/create_data_agent.py (the published Data Agent item id)
FABRIC_DATA_AGENT_ID=
# https://api.fabric.microsoft.com/v1/mcp/workspaces/<workspaceId>/dataagents/<dataAgentId>/agent
FABRIC_DATA_AGENT_MCP_URL=
# Foundry project connection (category MicrosoftFabric, authType AAD) used by the Fabric IQ tool

# --- Observability ---
APPLICATIONINSIGHTS_CONNECTION_STRING=
# The orchestration harness turns on MAF's OpenTelemetry instrumentation (one GenAI trace across
# LangGraph + Copilot SDK + Foundry). Set to true to also attach prompts/completions to the spans
# — only do that in a demo tenant.
OTEL_SENSITIVE_DATA=false

# --- Foundry Memory (long-term memory for DeliverySupport) ---
# Created by: python agents/delivery-support-agent/create_memory_store.py
DELIVERY_MEMORY_ENABLED=true
DELIVERY_MEMORY_STORE_NAME=zava_delivery_memory
# One scope = one customer. The demo uses a single fixed customer; in production you would
# pass the signed-in user id (Foundry also supports the {{$userId}} template + x-memory-user-id).
DELIVERY_MEMORY_SCOPE=zava-customer-demo
# Seconds Foundry waits after a turn before extracting memories (debounce, 0-3600).
DELIVERY_MEMORY_UPDATE_DELAY=5
# Days a memory survives without being re-confirmed (0 = never expire).
DELIVERY_MEMORY_TTL_DAYS=30

# --- Incident-response orchestration (Demo #2: multi-framework + MAF + hosted) ---
ORCHESTRATION_AGENT_NAME=IncidentResponseOrchestrator
ORCHESTRATION_AGENT_ENDPOINT=https://<orchestrator-aca-fqdn>/responses
COMPLIANCE_AGENT_NAME=ComplianceReviewer
# Model the Code Fix agent (GitHub Copilot SDK) uses; and Triage/Compliance model.
CODE_FIX_MODEL=claude-sonnet-4.5

# Foundry Hosted Agent registration of the whole orchestration (azd deploy incident-orchestration)
ORCHESTRATION_HOSTED_AGENT_NAME=IncidentOrchestrator
ORCHESTRATION_HOSTED_AGENT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/zava-project/agents/IncidentOrchestrator/endpoint/protocols/openai/responses?api-version=v1
TRIAGE_MODEL=model-router
COMPLIANCE_MODEL=model-router
# For running the Code Fix harness headless in a container, provide a GitHub token
# with Copilot access (locally it uses your logged-in GitHub Copilot CLI user).
# GITHUB_TOKEN=

# --- Foundry IQ (Azure AI Search knowledge base) + Agent Toolbox ---
FOUNDRY_ACCOUNT_NAME=<foundry-account>
FOUNDRY_PROJECT_NAME=zava-project
FOUNDRY_IQ_KNOWLEDGE_SOURCE=zava-docs-ks
FOUNDRY_IQ_KNOWLEDGE_BASE=zava-kb
FOUNDRY_IQ_CONNECTION_NAME=zava-kb-mcp
FOUNDRY_IQ_KB_MCP_URL=https://<search-service>.search.windows.net/knowledgeBases/zava-kb/mcp?api-version=2026-05-01-preview
FOUNDRY_TOOLBOX_NAME=zava-toolbox
FOUNDRY_TOOLBOX_CONNECTION_NAME=zava-toolbox-mcp
FABRIC_DATA_AGENT_CONNECTION_NAME=fabric_zava_dataagent
